# Copy to `.env` and fill in. All variables are optional: without them the app
# runs in demo mode (keyword-based assistant + in-memory storage).
# These are read on the server only and are never sent to the browser.

# Google Gemini API key (https://aistudio.google.com/app/apikey)
NUXT_GEMINI_API_KEY=
# Gemini model to use
NUXT_GEMINI_MODEL=gemini-2.5-flash

# Supabase project URL and API key (Project Settings → API)
NUXT_SUPABASE_URL=
NUXT_SUPABASE_KEY=
# Table that stores todos
NUXT_SUPABASE_TABLE=todos
